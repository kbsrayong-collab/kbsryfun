rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLoanContract(data) {
      return data.id is string && data.id.size() <= 128
        && data.contractNo is string && data.contractNo.size() <= 100
        && data.contractDate is string && data.contractDate.size() <= 50
        && data.borrowerName is string && data.borrowerName.size() <= 200
        && data.fiscalYear is number
        && data.purpose is string && data.purpose.size() <= 1000
        && data.loanAmount is number && data.loanAmount >= 0
        && data.dueDate is string && data.dueDate.size() <= 50
        && (!('position' in data) || (data.position is string && data.position.size() <= 200))
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('loanType' in data) || (data.loanType is string && data.loanType.size() <= 50))
        && (!('budgetType' in data) || (data.budgetType is string && data.budgetType.size() <= 100))
        && (!('disbursementDate' in data) || (data.disbursementDate is string && data.disbursementDate.size() <= 50))
        && (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 1000))
        && (!('repayments' in data) || (data.repayments is list && data.repayments.size() <= 100))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 255
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('role' in data) || (data.role is string && data.role.size() <= 50))
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contractId) && isValidLoanContract(incoming());
      allow update: if isSignedIn() && isValidId(contractId) && isValidLoanContract(incoming());
      allow delete: if isSignedIn() && isValidId(contractId);
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create, update: if isSignedIn() && (request.auth.uid == userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
